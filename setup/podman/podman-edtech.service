[Unit]
Description=CollectiveGPT / ed-tech.app Compose Stack (Podman)
After=network-online.target podman.socket podman-traefik.service
Wants=network-online.target
Requires=podman.socket podman-traefik.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/podman/ed-tech-app
ExecStart=/usr/bin/podman compose up -d
ExecStop=/usr/bin/podman compose down
ExecReload=/usr/bin/podman compose up -d
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=podman.target
